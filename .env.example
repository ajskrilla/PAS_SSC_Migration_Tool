# Copy to .env and adjust. Compose reads these.
POSTGRES_PASSWORD=changeme_dev_only
ASPNETCORE_ENVIRONMENT=Development

# AI provider: ollama (default, in-tenant, runs in a container) or azure_openai
AI_PROVIDER=ollama

# In-container Ollama endpoint (service name on the compose network).
OLLAMA_ENDPOINT=http://ollama:11434

# Models pulled on first run. llama3.1:8b has solid function-calling and fits 16GB on CPU.
# On low-RAM / slow hosts, try qwen2.5:7b or llama3.2:3b for faster responses.
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Safety classifier (Llama Guard) for the assistant's slow path only — never runs on the fast,
# keyword-routed data-lookup queries, which don't touch a generative model at all. 1.6GB, cheap
# to run on every slow-path question/answer. Flagged input is blocked before the main model runs;
# flagged output is logged to event_log (event_type "ai_safety") for review after streaming, not
# blocked, so live token streaming isn't held up waiting on a second model call.
OLLAMA_GUARD_MODEL=llama-guard3:1b

# --- Azure OpenAI (only used when AI_PROVIDER=azure_openai) ---
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_DEPLOYMENT=
# AZURE_OPENAI_EMBED_DEPLOYMENT=
